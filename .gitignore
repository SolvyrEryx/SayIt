# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.dist-info/
.pytest_cache/

# Briefcase build cache / generated metadata
.briefcase/

# Build / release artifacts (distributed as GitHub Release assets, not committed)
installer-output/
*.exe
*.AppImage
*.msi
*.sha256

# Virtual environments
.venv
.venv-win/
# Stray/broken local virtualenvs (e.g. a WSL venv left in the tree). The bare
# ".venv" above is an exact match, so sibling names must be ignored explicitly.
.venv.*/
.venv-*/

# Logs (runtime launch logs, etc.)
*.log

# Local test-run output captures (pytest terminal dumps saved to files during
# manual debugging). Not product source; must never be committed.
full_suite_out.txt
suite_full_run.txt
suite_run2.txt
*suite*run*.txt

# Editor / tooling workspace
.kiro/

# Internal research evidence, phase reports, and generated benchmark data.
# Not product source, not packaged, and intentionally excluded from the public
# repository (keeps the public tree free of historical development material).
artifacts/

# personal documentation
*private*.md
# Build-time generated SayIt icon derivatives (canonical source is icons/sayit.svg)
icons/sayit.ico
icons/sayit-*.png
icons/sayit.png

# Build-time Linux runtime dependency generated by scripts/vendor_portaudio.py
src/sayit/_vendor/linux/libportaudio.so*

# Build-time staged offline-installer model weights (1.3+ GiB). These are
# copied in from the validated model store by scripts/stage_bundled_models.py
# during a Full Offline Installer build and verified against the committed
# bundled_models.json hash manifest. The manifest IS committed; the weights
# are not.
src/sayit/resources/bundled_models/
